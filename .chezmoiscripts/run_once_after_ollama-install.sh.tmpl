{{- if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
set -euo pipefail

# The installer kills and replaces an existing app; Ollama.app self-updates anyway.
if [ ! -d /Applications/Ollama.app ]; then
    # May prompt for sudo to symlink /usr/local/bin/ollama
    curl -fsSL https://ollama.com/install.sh | sh
fi

# pull needs the server, which an existing install may not be running
pgrep -x Ollama >/dev/null || open -a Ollama --args hidden
for _ in $(seq 30); do ollama list >/dev/null 2>&1 && break; sleep 1; done

ollama pull gemma4:e4b
{{- end }}
